# Copy to .env for local development. Replace all passwords/tokens before deployment.
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_PORT=13307
RABBITMQ_DEFAULT_USER=observability
RABBITMQ_DEFAULT_PASS=change-me-strong-rabbit-password
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=25673
RABBITMQ_INTERNAL_PORT=5672
RABBITMQ_HOST=rabbitmq
GATEWAY_PORT=8080
GATEWAY_TIMEOUT_SECONDS=8
AUTH_REQUIRED=false
OBSERVABILITY_API_TOKEN=change-me-api-token
MAX_TELEMETRY_BODY_BYTES=1048576
TRACE_COMPLETION_WAIT_SECONDS=15
METRIC_THRESHOLDS_JSON={"response_time_ms":1000,"latency_ms":1000,"error_rate":5,"request_rate":1000}
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080
MYSQL_HOST=mysql
MYSQL_INTERNAL_PORT=3306
INGESTION_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_ingestion?charset=utf8mb4
TRACES_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_traces?charset=utf8mb4
LOGS_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_logs?charset=utf8mb4
METRICS_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_metrics?charset=utf8mb4
RCA_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_rca?charset=utf8mb4
ORDERS_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_orders?charset=utf8mb4
PAYMENTS_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_payments?charset=utf8mb4
NOTIFICATIONS_DATABASE_URL=mysql+pymysql://root:change-me-strong-root-password@mysql:3306/observability_notifications?charset=utf8mb4
INGESTION_URL=http://ingestion:8000
TRACE_PROCESSOR_URL=http://trace-processor:8000
LOG_PROCESSOR_URL=http://log-processor:8000
METRICS_URL=http://metrics:8000
RCA_URL=http://rca:8000
QUERY_URL=http://query:8000
ORDER_URL=http://order:8000
PAYMENT_URL=http://payment:8000
PAYMENT_SERVICE_URL=http://payment:8000
PAYMENT_TIMEOUT_SECONDS=5
NOTIFICATION_URL=http://notification:8000
NOTIFICATION_SERVICE_URL=http://notification:8000
NOTIFICATION_TIMEOUT_SECONDS=2
